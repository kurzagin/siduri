# === LLM Provider Selection ===
# Which provider to use: zhipu (default), openai, gemini, claude, grok
LLM_PROVIDER=zhipu
# Optional: override the default model for your chosen provider
# LLM_MODEL=glm-4.7-flash

# === API Keys (fill in the one matching your LLM_PROVIDER) ===
ZHIPU_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# === VOICEVOX Engine Settings ===
VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_CHARACTER_NAME=ナースロボ＿タイプＴ
VOICEVOX_RETRY_COOLDOWN_SECONDS=60
VOICEVOX_REQUEST_TIMEOUT=5
VOICEVOX_SYNTHESIS_TIMEOUT=15
VOICEVOX_ENABLED=true
